                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "{{SITE_URL}}",
                        "parameters/method": "GET",
                        "parameters/uri": "_api/web/lists/getbytitle('予約表')/items?$select=Id&$filter=Title eq '@{items('止まった承認待ちごと')?['Id']}'",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "止まったの予約表をそろえる": {
                    "type": "Foreach",
                    "foreach": "@body('止まったの予約表')?['value']",
                    "actions": {
                      "止まったの予約の削除": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "{{SITE_URL}}",
                            "parameters/method": "POST",
                            "parameters/uri": "_api/web/lists/getbytitle('予約表')/items(@{items('止まったの予約表をそろえる')?['Id']})",
                            "parameters/headers": {
                              "Accept": "application/json;odata=nometadata",
                              "IF-MATCH": "*",
                              "X-HTTP-Method": "DELETE"
                            }
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    },
                    "runAfter": {
                      "止まったの予約表": [
                        "Succeeded"
                      ]
                    }
                  },
                  "止まった記録のメール": {
                    "runAfter": {
                      "止まったの予約表をそろえる": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "emailMessage/To": "@{items('止まった承認待ちごと')?['Requester']?['EMail']}",
                        "emailMessage/Subject": "@{concat('【備品貸出】申請を期限切れにしました：', items('止まった承認待ちごと')?['Equipment']?['Title'])}",
                        "emailMessage/Body": "<p>承認の処理が期限までに終わらなかったため、申請を期限切れにしました。必要であれば、もう一度申請してください。</p>",
                        "emailMessage/Importance": "Normal"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                },
                "runAfter": {
                  "止まった承認待ち": [
                    "Succeeded"
                  ]
                }
              },
              "確認中の取得": {
                "runAfter": {
                  "止まった承認待ちごと": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "HttpRequest",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "{{SITE_URL}}",
                    "parameters/method": "GET",
                    "parameters/uri": "_api/web/lists/getbytitle('貸出記録')/items?$select=Id,LoanStatus,StartDate,DueDate,ReminderCount,LastNotifiedDate,ApprovalStartedAt,Created,Equipment/Title,Requester/EMail,Requester/Title&$expand=Equipment,Requester&$top=500&$filter=LoanStatus eq '確認中'",
                    "parameters/headers": {
                      "Accept": "application/json;odata=minimalmetadata"
                    }
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "作りかけ": {
                "type": "Query",
                "inputs": {
                  "from": "@body('確認中の取得')?['value']",
                  "where": "@less(ticks(item()?['Created']), ticks(addHours(utcNow(), -1)))"
                },
                "runAfter": {
                  "確認中の取得": [
                    "Succeeded"
                  ]
                }
              },
              "作りかけごと": {
                "type": "Foreach",
                "foreach": "@body('作りかけ')",
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 1
                  }
                },
                "actions": {
                  "作りかけをエラーにする": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "{{SITE_URL}}",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists/getbytitle('貸出記録')/items(@{items('作りかけごと')?['Id']})",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata",
                          "Content-Type": "application/json;odata=nometadata",
                          "IF-MATCH": "@{items('作りかけごと')?['odata.etag']}",
                          "X-HTTP-Method": "MERGE"
                        },
                        "parameters/body": "@string(setProperty(setProperty(json('{}'), 'LoanStatus', 'エラー'), 'ProcessNote', '確認中のまま1時間以上たったため、エラーにした'))"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "作りかけの予約表": {
                    "runAfter": {
                      "作りかけをエラーにする": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "{{SITE_URL}}",
                        "parameters/method": "GET",
                        "parameters/uri": "_api/web/lists/getbytitle('予約表')/items?$select=Id&$filter=Title eq '@{items('作りかけごと')?['Id']}'",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "作りかけの予約表をそろえる": {
                    "type": "Foreach",
                    "foreach": "@body('作りかけの予約表')?['value']",
                    "actions": {
                      "作りかけの予約の削除": {
                        "runAfter": {},
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "{{SITE_URL}}",
                            "parameters/method": "POST",
                            "parameters/uri": "_api/web/lists/getbytitle('予約表')/items(@{items('作りかけの予約表をそろえる')?['Id']})",
                            "parameters/headers": {
                              "Accept": "application/json;odata=nometadata",
                              "IF-MATCH": "*",
                              "X-HTTP-Method": "DELETE"
                            }
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      }
                    },
                    "runAfter": {
                      "作りかけの予約表": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "作りかけ": [
                    "Succeeded"
                  ]
                }
              }
            }
          }
        }
      },
      "失敗時": {
        "type": "Scope",
        "runAfter": {
          "試行": [
            "Succeeded",
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        },
        "actions": {
          "失敗があった": {
            "runAfter": {},
            "type": "If",
            "expression": {
              "or": [
                {
                  "equals": [
                    "@actions('設定の取得')?['status']",
                    "Failed"
                  ]
                },
                {
                  "equals": [
                    "@actions('開始日の切り替え')?['status']",
                    "Failed"
                  ]
                },
                {
                  "equals": [
                    "@actions('前日のお知らせと督促')?['status']",
                    "Failed"
                  ]
                },
                {
                  "equals": [
                    "@actions('止まった記録の後始末')?['status']",
                    "Failed"
                  ]
                },
                {
                  "equals": [
                    "@actions('試行')?['status']",
                    "Failed"
                  ]
                }
              ]
            },
            "actions": {
              "失敗した手順": {
                "runAfter": {},
                "type": "Query",
                "inputs": {
                  "from": "@result('試行')",
                  "where": "@equals(item()?['status'], 'Failed')"
                }
              },
              "失敗の要約": {
                "runAfter": {
                  "失敗した手順": [
                    "Succeeded"
                  ]
                },
                "type": "Select",
                "inputs": {
                  "from": "@body('失敗した手順')",
                  "select": "@concat(item()?['name'], ':', coalesce(item()?['code'], ''))"
                }
              },
              "処理ログに記録": {
                "runAfter": {
                  "失敗の要約": [
                    "Succeeded",
                    "Failed",
                    "Skipped",
                    "TimedOut"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "HttpRequest",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "{{SITE_URL}}",
                    "parameters/method": "POST",
                    "parameters/uri": "_api/web/lists/getbytitle('処理ログ')/items",
                    "parameters/headers": {
                      "Accept": "application/json;odata=nometadata",
                      "Content-Type": "application/json;odata=nometadata"
                    },
                    "parameters/body": "@string(setProperty(setProperty(setProperty(setProperty(setProperty(json('{}'), 'Title', 'FLW-003 期限の通知・督促'), 'Target', '毎朝の処理'), 'Result', '失敗'), 'Detail', take(join(body('失敗の要約'), ', '), 1000)), 'RunLink', setProperty(setProperty(json('{}'), 'Url', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])), 'Description', '実行の記録')))"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "管理者に知らせる": {
                "runAfter": {
                  "処理ログに記録": [
                    "Succeeded",
                    "Failed",
                    "Skipped",
                    "TimedOut"
                  ]
                },
                "type": "If",
                "expression": {
                  "not": {
                    "equals": [
                      "@variables('管理者メール')",
                      ""
                    ]
                  }
                },
                "actions": {
                  "管理者へのメール": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "emailMessage/To": "@variables('管理者メール')",
                        "emailMessage/Subject": "【備品貸出】処理に失敗しました（FLW-003 期限の通知・督促）",
                        "emailMessage/Body": "<p>FLW-003 期限の通知・督促で、処理に失敗しました。処理ログの最新の行と、実行の記録を確かめてください。</p>",
                        "emailMessage/Importance": "Normal"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                },
                "else": {
                  "actions": {}
                }
              }
            },
            "else": {
              "actions": {}
            }
          }
        }
      }
    }
  }
}
